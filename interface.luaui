--!nonstrict

-- Voltrex Interface
-- All UI construction lives here: startup, message boxes, main client UI,
-- player controls, spawn markers and name tags.

local Interface = {}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
while not LocalPlayer do
	task.wait()
	LocalPlayer = Players.LocalPlayer
end

local STARTUP_WIDTH = 431
local STARTUP_HEIGHT = 268
local MESSAGE_WIDTH = 431
local MESSAGE_HEIGHT = 200

local questionmarkicon = "rbxassetid://131274895694830"
local checkmarkicon = "rbxassetid://76884202320576"
local failureicon = "rbxassetid://71233372335407"

local STATUS_ICONS = {
	[1] = failureicon,
	[2] = questionmarkicon,
	[3] = checkmarkicon,
}

local MESSAGE_BUTTONS = {
	[0] = {{"OK", 1}},
	[1] = {{"OK", 1}, {"Cancel", 2}},
	[2] = {{"Abort", 3}, {"Retry", 4}, {"Ignore", 5}},
	[3] = {{"Yes", 6}, {"No", 7}, {"Cancel", 2}},
	[4] = {{"Yes", 6}, {"No", 7}},
	[5] = {{"Retry", 4}, {"Cancel", 2}},
	[6] = {{"Cancel", 2}, {"Try Again", 10}, {"Continue", 11}},
}

local DEFAULT_THEME = {
	OriginalBackground = Color3.fromRGB(55, 63, 76),
	Background = Color3.fromRGB(39, 45, 55),
	LeftPanel = Color3.fromRGB(23, 27, 33),
	Text = Color3.fromRGB(235, 238, 243),
	SecondaryText = Color3.fromRGB(170, 177, 188),
	Accent = Color3.fromRGB(107, 151, 255),
	LoadingBarBackground = Color3.fromRGB(50, 58, 69),

	BackgroundPrimary = Color3.fromRGB(16, 16, 16),
	BackgroundSecondary = Color3.fromRGB(24, 24, 24),
	BackgroundTertiary = Color3.fromRGB(29, 30, 35),
	Surface = Color3.fromRGB(32, 33, 39),
	SurfaceHover = Color3.fromRGB(39, 41, 48),
	SurfacePressed = Color3.fromRGB(45, 48, 57),
	Border = Color3.fromRGB(48, 48, 48),
	BorderSoft = Color3.fromRGB(37, 38, 43),
	TextColor = Color3.fromRGB(143, 180, 255),
	TextPrimary = Color3.fromRGB(236, 239, 246),
	TextSecondary = Color3.fromRGB(125, 145, 182),
	TextMuted = Color3.fromRGB(93, 96, 108),
	AccentSoft = Color3.fromRGB(53, 75, 126),
	Selected = Color3.fromRGB(42, 56, 85),
	Success = Color3.fromRGB(86, 190, 123),
	Warning = Color3.fromRGB(220, 169, 75),
	Error = Color3.fromRGB(211, 88, 103),
	IconBtn = Color3.fromRGB(19, 19, 22),
	Overlay = Color3.fromRGB(7, 8, 11),
	Scrollbar = Color3.fromRGB(75, 79, 92),
	White = Color3.fromRGB(255, 255, 255),
}

local function ThemeValue(theme, key)
	if theme and theme[key] ~= nil then
		return theme[key]
	end
	return DEFAULT_THEME[key]
end

local function WaitForPlayerLoaded()
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	LocalPlayer:WaitForChild("PlayerGui")

	local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	character:WaitForChild("Humanoid", 15)
	character:WaitForChild("HumanoidRootPart", 15)

	-- HasAppearanceLoaded can stay false forever in some custom-character games.
	-- Give normal Roblox appearance loading time to finish, then continue anyway.
	local appearanceStarted = os.clock()
	while not LocalPlayer:HasAppearanceLoaded() and (os.clock() - appearanceStarted) < 15 do
		RunService.Heartbeat:Wait()
	end

	RunService.RenderStepped:Wait()
end

local function AddResponsiveScale(guiObject, baseWidth, baseHeight, margin)
	margin = margin or 20
	local scale = Instance.new("UIScale")
	scale.Name = "ResponsiveScale"
	scale.Parent = guiObject
	local connection
	local function update()
		local camera = Workspace.CurrentCamera
		if not camera then return end
		local viewport = camera.ViewportSize
		local sx = math.max(1, viewport.X - margin * 2) / baseWidth
		local sy = math.max(1, viewport.Y - margin * 2) / baseHeight
		scale.Scale = math.clamp(math.min(sx, sy), 0.1, 1)
	end
	update()
	if Workspace.CurrentCamera then
		connection = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	guiObject.Destroying:Connect(function()
		if connection then connection:Disconnect() end
	end)
	return scale
end

local function CreateLeftTriangle(parent, width, height, color, zIndex)
	for x = 0, width - 1 do
		local progress = width > 1 and x / (width - 1) or 0
		local stripHeight = math.ceil(height * (1 - progress))
		if stripHeight > 0 then
			local strip = Instance.new("Frame")
			strip.BorderSizePixel = 0
			strip.BackgroundColor3 = color
			strip.Size = UDim2.fromOffset(2, stripHeight)
			strip.Position = UDim2.fromOffset(x, 0)
			strip.ZIndex = zIndex
			strip.Parent = parent
		end
	end
end

local function CreateRightTriangle(parent, width, height, color, zIndex)
	for x = 0, width - 1 do
		local progress = width > 1 and x / (width - 1) or 0
		local stripHeight = math.ceil(height * progress)
		if stripHeight > 0 then
			local strip = Instance.new("Frame")
			strip.BorderSizePixel = 0
			strip.BackgroundColor3 = color
			strip.Size = UDim2.fromOffset(2, stripHeight)
			strip.Position = UDim2.fromOffset(x, height - stripHeight)
			strip.ZIndex = zIndex
			strip.Parent = parent
		end
	end
end

function Interface.Startup(theme, titleText, subText, gameName, version, madeBy, status)
	theme = theme or {}
	titleText = tostring(titleText or "Dynamic Editor")
	subText = tostring(subText or "")
	gameName = tostring(gameName or "Game")
	version = tostring(version or "1.0")
	madeBy = tostring(madeBy or "Your Name")
	status = math.clamp(math.floor(tonumber(status) or 0), 0, 3)
	WaitForPlayerLoaded()

	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("DynamicEditorStartup")
	if old then old:Destroy() end

	local screen = Instance.new("ScreenGui")
	screen.Name = "DynamicEditorStartup"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 1000000
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Global
	screen.Parent = playerGui

	local main = Instance.new("CanvasGroup")
	main.Name = "Main"
	main.AnchorPoint = Vector2.new(0.5, 0.5)
	main.Position = UDim2.fromScale(0.5, 0.5)
	main.Size = UDim2.fromOffset(STARTUP_WIDTH, STARTUP_HEIGHT)
	main.BackgroundColor3 = ThemeValue(theme, "OriginalBackground")
	main.BorderSizePixel = 0
	main.ClipsDescendants = true
	main.ZIndex = 1
	main.Parent = screen
	AddResponsiveScale(main, STARTUP_WIDTH, STARTUP_HEIGHT, 20)

	local firstLeft = Instance.new("Frame")
	firstLeft.Size = UDim2.fromOffset(STARTUP_WIDTH, STARTUP_HEIGHT)
	firstLeft.Position = UDim2.fromOffset(-STARTUP_WIDTH, 0)
	firstLeft.BackgroundTransparency = 1
	firstLeft.ZIndex = 2
	firstLeft.Parent = main
	CreateLeftTriangle(firstLeft, STARTUP_WIDTH, STARTUP_HEIGHT, ThemeValue(theme, "Background"), 3)

	local firstRight = Instance.new("Frame")
	firstRight.Size = UDim2.fromOffset(STARTUP_WIDTH, STARTUP_HEIGHT)
	firstRight.Position = UDim2.fromOffset(STARTUP_WIDTH, 0)
	firstRight.BackgroundTransparency = 1
	firstRight.ZIndex = 2
	firstRight.Parent = main
	CreateRightTriangle(firstRight, STARTUP_WIDTH, STARTUP_HEIGHT, ThemeValue(theme, "Background"), 3)

	local firstInfo = TweenInfo.new(0.8, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	local leftTween = TweenService:Create(firstLeft, firstInfo, {Position = UDim2.fromOffset(0, 0)})
	local rightTween = TweenService:Create(firstRight, firstInfo, {Position = UDim2.fromOffset(0, 0)})
	local leftFinished = false
	local rightFinished = false

	leftTween.Completed:Connect(function()
		leftFinished = true
	end)

	rightTween.Completed:Connect(function()
		rightFinished = true
	end)

	leftTween:Play()
	rightTween:Play()

	repeat
		RunService.RenderStepped:Wait()
	until leftFinished and rightFinished

	main.BackgroundColor3 = ThemeValue(theme, "Background")
	firstLeft.Visible = false
	firstRight.Visible = false

	local leftWidth = math.floor(STARTUP_WIDTH * 0.70)
	local finalLeft = Instance.new("Frame")
	finalLeft.Size = UDim2.fromOffset(leftWidth, STARTUP_HEIGHT)
	finalLeft.Position = UDim2.fromOffset(-leftWidth, 0)
	finalLeft.BackgroundTransparency = 1
	finalLeft.ZIndex = 10
	finalLeft.Parent = main
	CreateLeftTriangle(finalLeft, leftWidth, STARTUP_HEIGHT, ThemeValue(theme, "LeftPanel"), 11)
	local finalTween = TweenService:Create(finalLeft, TweenInfo.new(0.65, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.fromOffset(0, 0)})
	finalTween:Play()

	local function textLabel(name, position, size, font, text, textSize, color, alignment)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.Position = position
		label.Size = size
		label.Font = font
		label.Text = text
		label.TextSize = textSize
		label.TextColor3 = color
		label.TextXAlignment = alignment or Enum.TextXAlignment.Left
		label.TextTransparency = 1
		label.ZIndex = 20
		label.Parent = main
		return label
	end

	local title = textLabel("Title", UDim2.fromOffset(18, 14), UDim2.fromOffset(350, 44), Enum.Font.GothamBold, titleText, 31, ThemeValue(theme, "Text"))
	local subtitle = textLabel("Subtitle", UDim2.fromOffset(19, 55), UDim2.fromOffset(350, 24), Enum.Font.Gotham, subText, 14, ThemeValue(theme, "SecondaryText"))
	local gameLabel = textLabel("GameName", UDim2.fromOffset(0, 105), UDim2.fromOffset(STARTUP_WIDTH, 38), Enum.Font.GothamBold, gameName, 25, ThemeValue(theme, "Text"), Enum.TextXAlignment.Center)
	local loadingText = textLabel("LoadingText", UDim2.fromOffset(68, 169), UDim2.fromOffset(220, 28), Enum.Font.Gotham, "Loading Modules", 15, ThemeValue(theme, "Text"))

	local versionText = textLabel("Version", UDim2.new(1, -134, 1, -67), UDim2.fromOffset(120, 24), Enum.Font.Gotham, version, 14, ThemeValue(theme, "SecondaryText"), Enum.TextXAlignment.Right)
	local madeByText = textLabel("MadeBy", UDim2.new(1, -314, 1, -38), UDim2.fromOffset(300, 24), Enum.Font.Gotham, "Made by " .. madeBy, 14, ThemeValue(theme, "SecondaryText"), Enum.TextXAlignment.Right)

	local statusIcon = Instance.new("ImageLabel")
	statusIcon.Name = "StatusIcon"
	statusIcon.BackgroundTransparency = 1
	statusIcon.AnchorPoint = Vector2.new(1, 0)
	statusIcon.Position = UDim2.new(1, -18, 0, 18)
	statusIcon.Size = UDim2.fromOffset(34, 34)
	statusIcon.ScaleType = Enum.ScaleType.Fit
	statusIcon.ImageTransparency = 1
	statusIcon.Visible = status > 0
	statusIcon.Image = STATUS_ICONS[status] or ""
	statusIcon.ZIndex = 25
	statusIcon.Parent = main

	local track = Instance.new("Frame")
	track.Position = UDim2.fromOffset(68, 204)
	track.Size = UDim2.fromOffset(135, 7)
	track.BackgroundColor3 = ThemeValue(theme, "LoadingBarBackground")
	track.BackgroundTransparency = 1
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.ZIndex = 20
	track.Parent = main
	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = ThemeValue(theme, "Accent")
	fill.BorderSizePixel = 0
	fill.ZIndex = 21
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	finalTween.Completed:Wait()
	local fade = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, label in ipairs({title, subtitle, gameLabel, loadingText, versionText, madeByText}) do
		TweenService:Create(label, fade, {TextTransparency = 0}):Play()
	end
	TweenService:Create(track, fade, {BackgroundTransparency = 0}):Play()
	if status > 0 then TweenService:Create(statusIcon, fade, {ImageTransparency = 0}):Play() end
	task.wait(0.2)
	local loadingTween = TweenService:Create(fill, TweenInfo.new(2.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 1, 0)})
	loadingTween:Play()
	loadingTween.Completed:Wait()
	task.wait(0.15)
	local closeTween = TweenService:Create(main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1})
	closeTween:Play()
	closeTween.Completed:Wait()
	if screen.Parent then screen:Destroy() end
end

function Interface.MessageBox(theme, titleText, messageText, valueButtons)
	theme = theme or {}
	titleText = tostring(titleText or "Dynamic Editor")
	messageText = tostring(messageText or "")
	valueButtons = math.floor(tonumber(valueButtons) or 0)
	if MESSAGE_BUTTONS[valueButtons] == nil then valueButtons = 0 end
	WaitForPlayerLoaded()

	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("DynamicEditorMessageBox")
	if old then old:Destroy() end

	local screen = Instance.new("ScreenGui")
	screen.Name = "DynamicEditorMessageBox"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 1000001
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Global
	screen.Parent = playerGui

	local main = Instance.new("CanvasGroup")
	main.Name = "Main"
	main.AnchorPoint = Vector2.new(0.5, 0.5)
	main.Position = UDim2.fromScale(0.5, 0.5)
	main.Size = UDim2.fromOffset(MESSAGE_WIDTH, MESSAGE_HEIGHT)
	main.BackgroundColor3 = ThemeValue(theme, "Background")
	main.BorderSizePixel = 0
	main.ClipsDescendants = true
	main.GroupTransparency = 1
	main.ZIndex = 100
	main.Parent = screen
	AddResponsiveScale(main, MESSAGE_WIDTH, MESSAGE_HEIGHT, 18)
	local mainCorner = Instance.new("UICorner")
	mainCorner.CornerRadius = UDim.new(0, 7)
	mainCorner.Parent = main

	local strip = Instance.new("Frame")
	strip.Size = UDim2.fromOffset(6, MESSAGE_HEIGHT)
	strip.BackgroundColor3 = ThemeValue(theme, "LeftPanel")
	strip.BorderSizePixel = 0
	strip.ZIndex = 101
	strip.Parent = main

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromOffset(22, 16)
	title.Size = UDim2.new(1, -44, 0, 32)
	title.Font = Enum.Font.GothamBold
	title.Text = titleText
	title.TextSize = 23
	title.TextColor3 = ThemeValue(theme, "Text")
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.ZIndex = 110
	title.Parent = main

	local message = Instance.new("TextLabel")
	message.BackgroundTransparency = 1
	message.Position = UDim2.fromOffset(22, 55)
	message.Size = UDim2.new(1, -44, 0, 76)
	message.Font = Enum.Font.Gotham
	message.Text = messageText
	message.TextSize = 15
	message.TextColor3 = ThemeValue(theme, "SecondaryText")
	message.TextWrapped = true
	message.TextXAlignment = Enum.TextXAlignment.Left
	message.TextYAlignment = Enum.TextYAlignment.Top
	message.ZIndex = 110
	message.Parent = main

	local buttonContainer = Instance.new("Frame")
	buttonContainer.BackgroundTransparency = 1
	buttonContainer.AnchorPoint = Vector2.new(0.5, 1)
	buttonContainer.Position = UDim2.new(0.5, 0, 1, -16)
	buttonContainer.Size = UDim2.new(1, -36, 0, 40)
	buttonContainer.ZIndex = 110
	buttonContainer.Parent = main
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.Parent = buttonContainer

	local buttons = MESSAGE_BUTTONS[valueButtons]
	local buttonWidth = #buttons == 1 and 130 or (#buttons == 2 and 135 or 118)
	local resultEvent = Instance.new("BindableEvent")
	local selected = false

	local function selectButton(code)
		if selected then return end
		selected = true
		local close = TweenService:Create(main, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 1})
		close:Play()
		close.Completed:Wait()
		if screen.Parent then screen:Destroy() end
		resultEvent:Fire(code)
	end

	for index, data in ipairs(buttons) do
		local button = Instance.new("TextButton")
		button.LayoutOrder = index
		button.Size = UDim2.fromOffset(buttonWidth, 38)
		button.BackgroundColor3 = ThemeValue(theme, "LoadingBarBackground")
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Font = Enum.Font.GothamMedium
		button.Text = data[1]
		button.TextSize = 14
		button.TextColor3 = ThemeValue(theme, "Text")
		button.ZIndex = 120
		button.Parent = buttonContainer
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = button
		button.MouseEnter:Connect(function()
			if not selected then TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = ThemeValue(theme, "Accent")}):Play() end
		end)
		button.MouseLeave:Connect(function()
			if not selected then TweenService:Create(button, TweenInfo.new(0.12), {BackgroundColor3 = ThemeValue(theme, "LoadingBarBackground")}):Play() end
		end)
		button.Activated:Connect(function() selectButton(data[2]) end)
	end

	main.Size = UDim2.fromOffset(MESSAGE_WIDTH - 18, MESSAGE_HEIGHT - 12)
	local open = TweenService:Create(main, TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = UDim2.fromOffset(MESSAGE_WIDTH, MESSAGE_HEIGHT),
		GroupTransparency = 0,
	})
	open:Play()
	local code = resultEvent.Event:Wait()
	resultEvent:Destroy()
	return code
end


