function Interface.Build(theme, runtimeConfig, actions)
	theme = theme or {}
	runtimeConfig = runtimeConfig or {}
	actions = actions or {}

	local UserInputService = game:GetService("UserInputService")
	local playerGui = LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild("Voltrex")
	if old then old:Destroy() end

	local UI = {
		Actions = {},
		Pages = {},
		NavButtons = {},
		PlayerCards = {},
		Connections = {},
		SelectedPlayer = nil,
	}

	local function C(key)
		return ThemeValue(theme, key)
	end

	local Background = C("Background")
	local Panel = C("LeftPanel")
	local Text = C("Text")
	local Muted = C("SecondaryText")
	local Accent = C("Accent")
	local Track = C("LoadingBarBackground")
	local RowHover = Background:Lerp(Text, 0.055)
	local RowPressed = Background:Lerp(Text, 0.09)
	local Divider = Track:Lerp(Background, 0.18)

	local function Connect(signal, callback)
		local connection = signal:Connect(callback)
		table.insert(UI.Connections, connection)
		return connection
	end

	local function New(className, properties, parent)
		local object = Instance.new(className)
		for property, value in pairs(properties or {}) do
			object[property] = value
		end
		if parent then object.Parent = parent end
		return object
	end

	local function Round(object, radius)
		return New("UICorner", {
			CornerRadius = UDim.new(0, radius or 6),
		}, object)
	end

	local function Stroke(object, color, transparency, thickness)
		return New("UIStroke", {
			Color = color or Track,
			Transparency = transparency or 0,
			Thickness = thickness or 1,
		}, object)
	end

	local function Label(parent, text, size, position, color, font, textSize, zIndex)
		return New("TextLabel", {
			Size = size,
			Position = position or UDim2.new(),
			BackgroundTransparency = 1,
			Text = tostring(text or ""),
			TextColor3 = color or Text,
			Font = font or Enum.Font.Gotham,
			TextSize = textSize or 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = zIndex or 10,
		}, parent)
	end

	local gui = New("ScreenGui", {
		Name = "Voltrex",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 999999,
		ZIndexBehavior = Enum.ZIndexBehavior.Global,
	}, playerGui)
	UI.Gui = gui

	local launcher = New("TextButton", {
		Name = "Launcher",
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Panel,
		BorderSizePixel = 0,
		Text = "V",
		TextColor3 = Text,
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		AutoButtonColor = false,
		ZIndex = 500,
	}, gui)
	Round(launcher, 9)
	Stroke(launcher, Track, 0.25, 1)

	local WINDOW_WIDTH = 700
	local WINDOW_HEIGHT = 480

	local main = New("CanvasGroup", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT),
		BackgroundColor3 = Background,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		GroupTransparency = 1,
		Visible = false,
		ZIndex = 100,
	}, gui)
	UI.Main = main
	Round(main, 8)
	Stroke(main, Track, 0.2, 1)
	AddResponsiveScale(main, WINDOW_WIDTH, WINDOW_HEIGHT, 26)

	local leftAccent = New("Frame", {
		Size = UDim2.fromOffset(4, WINDOW_HEIGHT),
		BackgroundColor3 = Panel,
		BorderSizePixel = 0,
		ZIndex = 101,
	}, main)

	local header = New("Frame", {
		Name = "Header",
		Size = UDim2.new(1, -4, 0, 58),
		Position = UDim2.fromOffset(4, 0),
		BackgroundColor3 = Panel,
		BorderSizePixel = 0,
		ZIndex = 102,
	}, main)

	Label(header, "VOLTREX", UDim2.fromOffset(160, 28), UDim2.fromOffset(16, 7), Text, Enum.Font.GothamBold, 20, 103)
	Label(header, "local client", UDim2.fromOffset(160, 18), UDim2.fromOffset(17, 34), Muted, Enum.Font.Gotham, 12, 103)

	local selectedName = Label(header, "No player selected", UDim2.fromOffset(230, 22), UDim2.new(1, -280, 0, 7), Text, Enum.Font.GothamBold, 13, 103)
	selectedName.TextXAlignment = Enum.TextXAlignment.Right
	UI.SelectedName = selectedName

	local selectedUser = Label(header, "Select a player", UDim2.fromOffset(230, 18), UDim2.new(1, -280, 0, 31), Muted, Enum.Font.Gotham, 11, 103)
	selectedUser.TextXAlignment = Enum.TextXAlignment.Right
	UI.SelectedUser = selectedUser

	local closeButton = New("TextButton", {
		Name = "Close",
		Size = UDim2.fromOffset(28, 28),
		Position = UDim2.new(1, -38, 0, 10),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "×",
		TextColor3 = Muted,
		Font = Enum.Font.GothamMedium,
		TextSize = 22,
		AutoButtonColor = false,
		ZIndex = 104,
	}, header)

	Connect(closeButton.MouseEnter, function()
		TweenService:Create(closeButton, TweenInfo.new(0.1), {TextColor3 = Text}):Play()
	end)
	Connect(closeButton.MouseLeave, function()
		TweenService:Create(closeButton, TweenInfo.new(0.1), {TextColor3 = Muted}):Play()
	end)

