	shortcutLabel.TextXAlignment = Enum.TextXAlignment.Right

	-- Drag from the header.
	local dragging = false
	local dragStart
	local startPosition
	Connect(header.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = input.Position
			startPosition = main.Position
		end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	Connect(UserInputService.InputChanged, function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)

	local function CreatePage(name)
		local page = New("ScrollingFrame", {
			Name = name,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Track,
			Visible = false,
			ZIndex = 103,
		}, content)
		New("UIListLayout", {
			Padding = UDim.new(0, 0),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}, page)
		New("UIPadding", {
			PaddingBottom = UDim.new(0, 8),
		}, page)
		UI.Pages[name] = page
		return page
	end

	local currentPage = nil
	local function SetPage(name)
		currentPage = name
		for pageName, page in pairs(UI.Pages) do
			page.Visible = pageName == name
		end
		for pageName, button in pairs(UI.NavButtons) do
			local active = pageName == name
			button.TextColor3 = active and Text or Muted
			local underline = button:FindFirstChild("Underline")
			if underline then underline.BackgroundTransparency = active and 0 or 1 end
		end
	end

	local navOrder = {
		{"Player", "PLAYER"},
		{"Aim", "AIM"},
		{"Movement", "MOVE"},
		{"Visuals", "VISUAL"},
		{"System", "SYSTEM"},
	}

	for index, info in ipairs(navOrder) do
		local pageName = info[1]
		local button = New("TextButton", {
			Name = pageName .. "Nav",
			LayoutOrder = index,
			Size = UDim2.fromOffset(pageName == "Movement" and 92 or (pageName == "Visuals" and 80 or 72), 32),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = info[2],
			TextColor3 = Muted,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			AutoButtonColor = false,
			ZIndex = 103,
		}, nav)
		local underline = New("Frame", {
			Name = "Underline",
			AnchorPoint = Vector2.new(0, 1),
			Size = UDim2.new(1, 0, 0, 2),
			Position = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 104,
		}, button)
		UI.NavButtons[pageName] = button
		Connect(button.MouseButton1Click, function() SetPage(pageName) end)
	end

	local function CreateSection(parent, text)
		local holder = New("Frame", {
			Size = UDim2.new(1, -4, 0, 34),
			BackgroundTransparency = 1,
			ZIndex = 104,
		}, parent)
		Label(holder, string.upper(text), UDim2.new(1, 0, 1, 0), UDim2.new(), Muted, Enum.Font.GothamBold, 12, 105)
		return holder
	end

	local function AddDivider(parent)
		return New("Frame", {
			Size = UDim2.new(1, -4, 0, 1),
			BackgroundColor3 = Divider,
			BorderSizePixel = 0,
			ZIndex = 104,
		}, parent)
	end

	local function BaseRow(parent, height)
		local row = New("Frame", {
			Size = UDim2.new(1, -4, 0, height or 54),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 104,
		}, parent)
		return row
	end

	local function AddRowLabels(row, title, description, rightSpace)
		rightSpace = rightSpace or 90
		local titleLabel = Label(row, title, UDim2.new(1, -rightSpace, 0, 22), UDim2.fromOffset(0, 5), Text, Enum.Font.GothamMedium, 14, 106)
		local descLabel = Label(row, description or "", UDim2.new(1, -rightSpace, 0, 18), UDim2.fromOffset(0, 30), Muted, Enum.Font.Gotham, 11, 106)
		return titleLabel, descLabel
	end

	local function CreateToggle(parent, key, title, description, callback)
		local row = BaseRow(parent, 54)
		local _, desc = AddRowLabels(row, title, description, 84)

		local track = New("Frame", {
			Size = UDim2.fromOffset(38, 20),
			Position = UDim2.new(1, -40, 0.5, -10),
			BackgroundColor3 = Track,
			BorderSizePixel = 0,
			ZIndex = 106,
		}, row)
		Round(track, 99)

		local knob = New("Frame", {
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.fromOffset(2, 2),
			BackgroundColor3 = Muted,
			BorderSizePixel = 0,
			ZIndex = 107,
		}, track)
		Round(knob, 99)

		local hit = New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Text = "",
			AutoButtonColor = false,
			ZIndex = 108,
		}, row)

		Connect(hit.MouseEnter, function()
			row.BackgroundTransparency = 0
			row.BackgroundColor3 = RowHover
		end)
		Connect(hit.MouseLeave, function()
			row.BackgroundTransparency = 1
		end)
		if callback then Connect(hit.MouseButton1Click, callback) end

		UI.Actions[key] = {
			Type = "Toggle",
			Track = track,
			Knob = knob,
			Desc = desc,
			Row = row,
		}
		AddDivider(parent)
		return row
	end

	local function CreateAction(parent, key, title, description, buttonText, callback)
		local row = BaseRow(parent, 54)
		local _, desc = AddRowLabels(row, title, description, 108)
		local button = New("TextButton", {
			Size = UDim2.fromOffset(88, 30),
			Position = UDim2.new(1, -90, 0.5, -15),
			BackgroundColor3 = Panel,
			BorderSizePixel = 0,
			Text = string.upper(buttonText or "RUN"),
			TextColor3 = Text,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			AutoButtonColor = false,
			ZIndex = 107,
		}, row)
		Round(button, 5)
		Stroke(button, Track, 0.35, 1)
		Connect(button.MouseEnter, function()
			TweenService:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = RowPressed}):Play()
		end)
		Connect(button.MouseLeave, function()
			TweenService:Create(button, TweenInfo.new(0.1), {BackgroundColor3 = Panel}):Play()
		end)
		if callback then Connect(button.MouseButton1Click, callback) end
		UI.Actions[key] = {
			Type = "Action",
			Desc = desc,
			Button = button,
		}
		AddDivider(parent)
		return row
	end

	local function CreateInput(parent, title, description, defaultText, placeholder, callback)
		local row = BaseRow(parent, 54)
		AddRowLabels(row, title, description, 116)
		local box = New("TextBox", {
			Size = UDim2.fromOffset(92, 30),
			Position = UDim2.new(1, -94, 0.5, -15),
			BackgroundColor3 = Panel,
			BorderSizePixel = 0,
			Text = tostring(defaultText or ""),
			PlaceholderText = tostring(placeholder or ""),
			TextColor3 = Text,
			PlaceholderColor3 = Muted,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			ClearTextOnFocus = false,
			ZIndex = 107,
		}, row)
		Round(box, 5)
		Stroke(box, Track, 0.35, 1)
		Connect(box.FocusLost, function(enterPressed)
			if callback then callback(box.Text, enterPressed) end
		end)
		AddDivider(parent)
		return box, row
	end

	local function CreateStepper(parent, title, description, onMinus, onPlus)
		local row = BaseRow(parent, 54)
		local titleLabel, desc = AddRowLabels(row, title, description, 118)
		local minus = New("TextButton", {
			Size = UDim2.fromOffset(32, 30),
			Position = UDim2.new(1, -70, 0.5, -15),
			BackgroundColor3 = Panel,
			BorderSizePixel = 0,
			Text = "−",
			TextColor3 = Text,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			AutoButtonColor = false,
			ZIndex = 107,
		}, row)
		local plus = New("TextButton", {
			Size = UDim2.fromOffset(32, 30),
			Position = UDim2.new(1, -34, 0.5, -15),
			BackgroundColor3 = Panel,
			BorderSizePixel = 0,
			Text = "+",
			TextColor3 = Text,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			AutoButtonColor = false,
			ZIndex = 107,
		}, row)
		Round(minus, 5); Round(plus, 5)
		Stroke(minus, Track, 0.35, 1); Stroke(plus, Track, 0.35, 1)
		if onMinus then Connect(minus.MouseButton1Click, onMinus) end
		if onPlus then Connect(plus.MouseButton1Click, onPlus) end
		AddDivider(parent)
		return titleLabel, desc
	end

