		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, playerList)
	UI.PlayerList = playerList

	local function playerScrollLimit()
		return math.max(0, playerList.AbsoluteCanvasSize.X - playerList.AbsoluteSize.X)
	end

	local function scrollPlayerList(amount)
		local targetX = math.clamp(playerList.CanvasPosition.X + amount, 0, playerScrollLimit())
		TweenService:Create(playerList, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CanvasPosition = Vector2.new(targetX, 0),
		}):Play()
	end

	Connect(playerLeft.MouseButton1Click, function()
		scrollPlayerList(-142)
	end)
	Connect(playerRight.MouseButton1Click, function()
		scrollPlayerList(142)
	end)

	Connect(playerLeft.MouseEnter, function()
		TweenService:Create(playerLeft, TweenInfo.new(0.1), {BackgroundColor3 = RowPressed}):Play()
	end)
	Connect(playerLeft.MouseLeave, function()
		TweenService:Create(playerLeft, TweenInfo.new(0.1), {BackgroundColor3 = Panel}):Play()
	end)
	Connect(playerRight.MouseEnter, function()
		TweenService:Create(playerRight, TweenInfo.new(0.1), {BackgroundColor3 = RowPressed}):Play()
	end)
	Connect(playerRight.MouseLeave, function()
		TweenService:Create(playerRight, TweenInfo.new(0.1), {BackgroundColor3 = Panel}):Play()
	end)

	-- Roblox normally gives the mouse wheel to the outer vertical page.
	-- When the cursor is over the player strip, turn the wheel into horizontal scrolling.
	Connect(UserInputService.InputChanged, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseWheel then return end
		if not playerList.Visible then return end

		local mouse = UserInputService:GetMouseLocation()
		local pos = playerList.AbsolutePosition
		local size = playerList.AbsoluteSize
		if mouse.X < pos.X or mouse.X > pos.X + size.X or mouse.Y < pos.Y or mouse.Y > pos.Y + size.Y then
			return
		end

		local wheel = input.Position.Z
		if wheel ~= 0 then
			scrollPlayerList(-wheel * 90)
		end
	end)

