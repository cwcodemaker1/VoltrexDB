	-- Interface API used by Main.lua ----------------------------------
	function UI:SetStatus(text, mode)
		if not self.StatusLabel then return end
		self.StatusLabel.Text = tostring(text or "")
		self.StatusLabel.TextColor3 = mode == "good" and Text or Muted
		if self.StatusDot then
			self.StatusDot.BackgroundColor3 = mode == "good" and Accent or (mode == "warn" and Text or Muted)
		end
	end

	function UI:SetActionState(key, active, description)
		local ref = self.Actions[key]
		if not ref then return end
		if description and ref.Desc then
			ref.Desc.Text = tostring(description)
		end
		if ref.Type == "Toggle" and ref.Track and ref.Knob then
			TweenService:Create(ref.Track, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = active and Accent or Track,
			}):Play()
			TweenService:Create(ref.Knob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = active and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2),
				BackgroundColor3 = active and Text or Muted,
			}):Play()
		end
	end

	function UI:SetSelectedPlayer(player)
		self.SelectedPlayer = player
		if player and player.Parent == Players then
			self.SelectedName.Text = player.DisplayName
			self.SelectedUser.Text = "@" .. player.Name
			selectedName.Text = player.DisplayName
			selectedUser.Text = "@" .. player.Name
		else
			self.SelectedName.Text = "No player selected"
			self.SelectedUser.Text = "Select a player below"
			selectedName.Text = "No player selected"
			selectedUser.Text = "Select a player"
		end
		for p, card in pairs(self.PlayerCards) do
			if card and card.Parent then
				local isSelected = p == player
				card.BackgroundColor3 = isSelected and Accent or Panel
				card.TextColor3 = isSelected and Background or Text
			end
		end

		-- Keep the selected player visible even when the list is long.
		local selectedCard = player and self.PlayerCards[player]
		if selectedCard and selectedCard.Parent and self.PlayerList then
			task.defer(function()
				if not selectedCard.Parent or not self.PlayerList or not self.PlayerList.Parent then return end
				local listX = self.PlayerList.AbsolutePosition.X
				local listWidth = self.PlayerList.AbsoluteSize.X
				local cardX = selectedCard.AbsolutePosition.X
				local cardWidth = selectedCard.AbsoluteSize.X
				local currentX = self.PlayerList.CanvasPosition.X
				local targetX = currentX

				if cardX < listX then
					targetX = currentX - (listX - cardX) - 6
				elseif cardX + cardWidth > listX + listWidth then
					targetX = currentX + ((cardX + cardWidth) - (listX + listWidth)) + 6
				end

				local maxX = math.max(0, self.PlayerList.AbsoluteCanvasSize.X - self.PlayerList.AbsoluteSize.X)
				targetX = math.clamp(targetX, 0, maxX)
				self.PlayerList.CanvasPosition = Vector2.new(targetX, 0)
			end)
		end
	end

	function UI:RefreshPlayers(selectedPlayer)
		if not self.PlayerList then return end
		for player, card in pairs(self.PlayerCards) do
			if card then card:Destroy() end
			self.PlayerCards[player] = nil
		end

		local list = Players:GetPlayers()
		table.sort(list, function(a, b)
			if a == LocalPlayer then return true end
			if b == LocalPlayer then return false end
			return string.lower(a.DisplayName) < string.lower(b.DisplayName)
		end)

		for index, player in ipairs(list) do
			local card = New("TextButton", {
				Name = "P_" .. tostring(player.UserId),
				LayoutOrder = index,
				Size = UDim2.fromOffset(136, 34),
				BackgroundColor3 = player == selectedPlayer and Accent or Panel,
				BorderSizePixel = 0,
				Text = player.DisplayName,
				TextColor3 = player == selectedPlayer and Background or Text,
				Font = Enum.Font.GothamMedium,
				TextSize = 11,
				TextTruncate = Enum.TextTruncate.AtEnd,
				AutoButtonColor = false,
				ZIndex = 107,
			}, self.PlayerList)
			Round(card, 5)
			self.PlayerCards[player] = card
			Connect(card.MouseEnter, function()
				if self.SelectedPlayer ~= player then
					TweenService:Create(card, TweenInfo.new(0.1), {BackgroundColor3 = RowPressed}):Play()
				end
			end)
			Connect(card.MouseLeave, function()
				if self.SelectedPlayer ~= player then
					TweenService:Create(card, TweenInfo.new(0.1), {BackgroundColor3 = Panel}):Play()
				end
			end)
			Connect(card.MouseButton1Click, function()
				if actions.SetSelectedPlayer then actions.SetSelectedPlayer(player) end
			end)
		end
		self:SetSelectedPlayer(selectedPlayer)
	end

	function UI:UpdateSelectedUserText(text)
		if self.SelectedUser then self.SelectedUser.Text = tostring(text or "") end
		if selectedUser then selectedUser.Text = tostring(text or "") end
	end

	function UI:DrawSpawnpoint(player, spawn, visible, maxDistance)
		if not player or not spawn then return nil end
		local name = "SpawnpointDraw_" .. tostring(player.UserId)
		local oldMarker = playerGui:FindFirstChild(name)
		if oldMarker then oldMarker:Destroy() end
		local billboard = New("BillboardGui", {
			Name = name,
			Adornee = spawn,
			Size = UDim2.fromOffset(150, 40),
			StudsOffsetWorldSpace = Vector3.new(0, 4.5, 0),
			AlwaysOnTop = true,
			MaxDistance = maxDistance or 10000,
			Enabled = visible ~= false,
		}, playerGui)
		local holder = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Panel,
			BackgroundTransparency = 0.08,
			BorderSizePixel = 0,
		}, billboard)
		Round(holder, 5)
		Stroke(holder, Track, 0.2, 1)
		local label = Label(holder, player.DisplayName .. "  ·  SPAWN", UDim2.new(1, -12, 1, 0), UDim2.fromOffset(6, 0), Text, Enum.Font.GothamMedium, 10)
		label.TextXAlignment = Enum.TextXAlignment.Center
		return billboard
	end

	function UI:RemoveSpawnpoint(userId)
		local marker = playerGui:FindFirstChild("SpawnpointDraw_" .. tostring(userId))
		if marker then marker:Destroy() end
	end

	function UI:SetSpawnpointsVisible(visible)
		for _, object in ipairs(playerGui:GetChildren()) do
			if object:IsA("BillboardGui") and string.match(object.Name, "^SpawnpointDraw_") then
				object.Enabled = visible == true
			end
		end
	end

	function UI:RemoveNameTag(character)
		if not character then return end
		local head = character:FindFirstChild("Head")
		if head then
			local oldTag = head:FindFirstChild("VoltrexNameTag")
			if oldTag then oldTag:Destroy() end
		end
	end

	function UI:CreateNameTag(player, character, maxDistance)
		if not player or player == LocalPlayer or not character then return nil end
		local head = character:FindFirstChild("Head") or character:WaitForChild("Head", 5)
		if not head then return nil end
		self:RemoveNameTag(character)
		local billboard = New("BillboardGui", {
			Name = "VoltrexNameTag",
			Adornee = head,
			Size = UDim2.fromOffset(210, 42),
			StudsOffset = Vector3.new(0, 3.1, 0),
			AlwaysOnTop = true,
			MaxDistance = maxDistance or 1500,
		}, head)
		local display = Label(billboard, player.DisplayName, UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, 0), Text, Enum.Font.GothamBold, 11)
		display.TextXAlignment = Enum.TextXAlignment.Center
		local username = Label(billboard, "@" .. player.Name, UDim2.new(1, 0, 0, 18), UDim2.fromOffset(0, 23), Muted, Enum.Font.Gotham, 9)
		username.TextXAlignment = Enum.TextXAlignment.Center
		return billboard
	end

	local panelTween
	function UI:SetPanelOpen(open)
		open = open == true
		runtimeConfig.UIopen = open
		if panelTween then pcall(function() panelTween:Cancel() end) end
		if open then
			main.Visible = true
			main.GroupTransparency = 1
			main.Size = UDim2.fromOffset(WINDOW_WIDTH - 12, WINDOW_HEIGHT - 8)
			panelTween = TweenService:Create(main, TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
				GroupTransparency = 0,
				Size = UDim2.fromOffset(WINDOW_WIDTH, WINDOW_HEIGHT),
			})
			panelTween:Play()
			TweenService:Create(launcher, TweenInfo.new(0.12), {BackgroundColor3 = Accent, TextColor3 = Background}):Play()
		else
			panelTween = TweenService:Create(main, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				GroupTransparency = 1,
				Size = UDim2.fromOffset(WINDOW_WIDTH - 12, WINDOW_HEIGHT - 8),
			})
			local closing = panelTween
			panelTween:Play()
			TweenService:Create(launcher, TweenInfo.new(0.12), {BackgroundColor3 = Panel, TextColor3 = Text}):Play()
			task.spawn(function()
				closing.Completed:Wait()
				if not runtimeConfig.UIopen and main.Parent then main.Visible = false end
			end)
		end
	end

	Connect(closeButton.MouseButton1Click, function() UI:SetPanelOpen(false) end)
	Connect(launcher.MouseButton1Click, function() UI:SetPanelOpen(not runtimeConfig.UIopen) end)

	function UI:Destroy()
		for _, connection in ipairs(self.Connections) do
			pcall(function() connection:Disconnect() end)
		end
		table.clear(self.Connections)
		for _, object in ipairs(playerGui:GetChildren()) do
			if object:IsA("BillboardGui") and string.match(object.Name, "^SpawnpointDraw_") then
				pcall(function() object:Destroy() end)
			end
		end
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character then pcall(function() self:RemoveNameTag(player.Character) end) end
		end
		if gui and gui.Parent then gui:Destroy() end
	end

	SetPage("Player")
	UI:RefreshPlayers(nil)
	UI:SetStatus("Ready", "good")
	UI:SetPanelOpen(true)

	return UI
end

return Interface
